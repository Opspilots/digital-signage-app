# ─── Backend ────────────────────────────────────────────────────────────────
# Port the backend API listens on inside the container (default: 3001)
PORT=3001

# Allowed CORS origin(s). Use '*' to allow all origins (dev only).
# For production set to the hostname serving the frontend, e.g.:
#   CORS_ORIGIN=https://signage.example.com
# SECURITY: Restrict to prevent unauthorized API access
CORS_ORIGIN=*

# ─── SECURITY: Admin Credentials (REQUIRED for production) ──────────────────
# ADMIN_PASSWORD: Strong password for default admin user (created on first startup)
# CRITICAL: Must be a strong password in production (minimum 12 characters)
# Generate with: openssl rand -base64 16
# SECURITY WARNING: Server will fail to start if set to 'admin' or empty in production
ADMIN_PASSWORD=

# ADMIN_USERNAME: Username for default admin user (optional, defaults to 'admin')
ADMIN_USERNAME=admin

# ─── Secrets (REQUIRED for production) ────────────────────────────────────────
# Secret key for signing JWT tokens and webhooks
# Generate with: openssl rand -hex 32
# SECURITY: Must be unique and strong in production
JWT_SECRET=change_me_before_production_openssl_rand_hex_32

# Webhook secret for external integrations (video processing callbacks)
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=change_me_before_production_openssl_rand_hex_32

# ─── Environment ─────────────────────────────────────────────────────────────
# NODE_ENV: Set to 'production' for production deployments
# In production: ADMIN_PASSWORD is required, weak defaults not allowed
NODE_ENV=development

# ─── Frontend (baked in at build time by Vite) ───────────────────────────────
# Full URL of the backend API reachable from the browser.
# In a LAN/kiosk setup this is the host machine's IP, e.g.:
#   VITE_API_URL=http://192.168.1.100:3001
# SECURITY: For production, use HTTPS
VITE_API_URL=http://localhost:3001

# Title shown in the browser tab
VITE_APP_TITLE=Digital Signage

# ─── Configuration Commands ──────────────────────────────────────────────────
# Generate secrets (run these to create strong values):
#
# JWT_SECRET (32 hex characters):
#   openssl rand -hex 32
#
# WEBHOOK_SECRET (32 hex characters):
#   openssl rand -hex 32
#
# ADMIN_PASSWORD (base64 encoded random):
#   openssl rand -base64 16
